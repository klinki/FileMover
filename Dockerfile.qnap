# Native AOT CLI/helper must be generated and cross-published first with the
# tested 64 KiB ELF alignment. deploy/build-qnap.ps1 prepares the image context.
# No .NET SDK or CoreCLR is needed in the runtime image.
FROM alpine:3.17
RUN apk add --no-cache libgcc libstdc++ icu-libs musl-utils
WORKDIR /app
COPY BackupNormalizer BackupNormalizer.Migrations libe_sqlite3.so ./
COPY qnap-check.sh .
COPY qnap-inventory.sh .
RUN chmod +x BackupNormalizer BackupNormalizer.Migrations qnap-check.sh qnap-inventory.sh
ENTRYPOINT ["./BackupNormalizer"]
CMD ["--help"]
