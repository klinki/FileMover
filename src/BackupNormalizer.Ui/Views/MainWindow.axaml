<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BackupNormalizer.Ui.ViewModels"
        xmlns:models="using:BackupNormalizer.Ui.Models"
        xmlns:views="using:BackupNormalizer.Ui.Views"
        x:Class="BackupNormalizer.Ui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1280" Height="800" MinWidth="860" MinHeight="560"
        Title="BackupNormalizer - Inventory comparison and planner">
  <Window.Styles>
    <Style Selector="Border.panel">
      <Setter Property="BorderBrush" Value="Gray" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.panel.active">
      <Setter Property="BorderBrush" Value="DodgerBlue" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.diff.onlyLeft">
      <Setter Property="Background" Value="{DynamicResource OnlyLeftBrush}" />
    </Style>
    <Style Selector="Border.diff.onlyRight">
      <Setter Property="Background" Value="{DynamicResource OnlyRightBrush}" />
    </Style>
    <Style Selector="Border.diff.different">
      <Setter Property="Background" Value="{DynamicResource DifferentBrush}" />
    </Style>
    <Style Selector="Border.diff.unverified">
      <Setter Property="Background" Value="{DynamicResource UnverifiedBrush}" />
    </Style>
    <Style Selector="Border.diff.equal">
      <Setter Property="Background" Value="{DynamicResource EqualBrush}" />
    </Style>
  </Window.Styles>
  <Window.Resources>
    <DataTemplate x:Key="FileIconTemplate" x:DataType="vm:FileEntryItem">
      <Panel Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Path Data="M13,20H11V8L5.5,13.5L4.08,12.08L12,4.16L19.92,12.08L18.5,13.5L13,8V20Z"
              Fill="#78909C" Stretch="Uniform" IsVisible="{Binding IsParentEntry}" />
        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
              Fill="#E8A33D" Stretch="Uniform" IsVisible="{Binding IsFolder}" />
        <Path Data="M3,3H21V7H3V3M4,8H20V21H4V8M9.5,11A0.5,0.5 0 0,0 9,11.5V13H15V11.5A0.5,0.5 0 0,0 14.5,11H9.5Z"
              Fill="#8D6E63" Stretch="Uniform" IsVisible="{Binding IsArchive}" />
        <Path Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z"
              Fill="#43A047" Stretch="Uniform" IsVisible="{Binding IsImage}" />
        <Path Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
              Fill="#E53935" Stretch="Uniform" IsVisible="{Binding IsVideo}" />
        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M14,4L18,8H14V4M16,11H8V13H16V11M16,15H8V17H16V15Z"
              Fill="#1E88E5" Stretch="Uniform" IsVisible="{Binding IsText}" />
        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
              Fill="#9AA0A6" Stretch="Uniform" IsVisible="{Binding IsGenericFile}" />
      </Panel>
    </DataTemplate>
    <DataTemplate x:Key="PanelHeader" x:DataType="vm:FilePanelViewModel">
      <StackPanel Spacing="4" Margin="6">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <TextBlock Text="{Binding Side}" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Load database..." Tag="{Binding Side}" Click="OnLoadDatabase"
                  IsEnabled="{Binding CanChangeSource}" Padding="8,4" Margin="0,0,4,0" />
          <Button Grid.Column="2" Content="Live folders" Tag="{Binding Side}" Click="OnUseLive"
                  IsEnabled="{Binding CanChangeSource}" IsVisible="{Binding IsDatabase}" Padding="8,4" />
          <Button Grid.Column="3" Content="Health / errors..." Tag="{Binding Side}" Click="OnInventoryHealth"
                  IsVisible="{Binding IsDatabase}" Padding="8,4" Margin="4,0,0,0" />
        </Grid>
        <TextBlock Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceLabel}" />
        <ComboBox ItemsSource="{Binding InventoryRoots}" SelectedItem="{Binding SelectedInventoryRoot}"
                  IsVisible="{Binding IsDatabase}" IsEnabled="{Binding CanChangeSource}"
                  HorizontalAlignment="Stretch" ToolTip.Tip="Inventory root">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:InventoryRoot">
              <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Root.Path}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                  IsVisible="{Binding ShowDriveCombo}" HorizontalAlignment="Stretch" ToolTip.Tip="Select drive">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DriveView">
              <TextBlock Text="{Binding Display}" ToolTip.Tip="{Binding Tooltip}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ItemsControl IsVisible="{Binding ShowDriveButtons}" ItemsSource="{Binding Drives}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DriveView">
              <Button Content="{Binding Display}" CommandParameter="{Binding}" Click="OnDriveClick"
                      Tag="{Binding $parent[ItemsControl].DataContext.Side}" Margin="0,0,3,2" Padding="6,2" ToolTip.Tip="{Binding Tooltip}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
          <TextBlock Text="{Binding PathCaption}" VerticalAlignment="Center" FontSize="11" />
          <TextBox Grid.Column="1" Text="{Binding CurrentPath}" IsReadOnly="True" ToolTip.Tip="{Binding CurrentPath}" />
        </Grid>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        <TextBlock Text="{Binding SelectedInventoryRoot.HealthSummary}" IsVisible="{Binding IsDatabase}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedInventoryRoot.HealthSummary}" />
        <views:InventorySearchControl />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="NameCell" x:DataType="vm:FileEntryItem">
      <Grid ColumnDefinitions="3,*">
        <Border Classes="diff" Classes.onlyLeft="{Binding IsOnlyLeft}" Classes.onlyRight="{Binding IsOnlyRight}"
                Classes.different="{Binding IsDifferent}" Classes.unverified="{Binding IsUnverified}"
                Classes.equal="{Binding IsEqual}" Margin="0,3,0,3" />
        <TextBlock Grid.Column="1" Text="{Binding BaseName}" Classes.marked="{Binding IsMarked}"
                   Margin="5,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tooltip}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ExtCell" x:DataType="vm:FileEntryItem">
      <TextBlock Text="{Binding Extension}" Classes.marked="{Binding IsMarked}" VerticalAlignment="Center"
                 Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Extension}" />
    </DataTemplate>
    <DataTemplate x:Key="SizeCell" x:DataType="vm:FileEntryItem">
      <TextBlock Text="{Binding SizeText}" Classes.marked="{Binding IsMarked}" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SizeText}" />
    </DataTemplate>
    <DataTemplate x:Key="ModifiedCell" x:DataType="vm:FileEntryItem">
      <TextBlock Text="{Binding ModifiedText}" Classes.marked="{Binding IsMarked}" VerticalAlignment="Center"
                 Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModifiedText}" />
    </DataTemplate>
    <DataTemplate x:Key="ComparisonCell" x:DataType="vm:FileEntryItem">
      <TextBlock Text="{Binding ComparisonText}" Classes.marked="{Binding IsMarked}" TextTrimming="CharacterEllipsis"
                 Margin="4,0" ToolTip.Tip="{Binding ComparisonText}" VerticalAlignment="Center" />
    </DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Load database in left panel..." Tag="Left" Click="OnLoadDatabaseMenu" IsEnabled="{Binding CanChangePanelSource}" />
        <MenuItem Header="Load database in right panel..." Tag="Right" Click="OnLoadDatabaseMenu" IsEnabled="{Binding CanChangePanelSource}" />
        <MenuItem Header="Export active inventory snapshot..." Click="OnExportInventory" IsEnabled="{Binding CanExportInventory}" />
        <Separator />
        <MenuItem Header="Save plan JSON" Command="{Binding SaveJsonCommand}" />
        <MenuItem Header="Write plan to DB" Command="{Binding WriteToDbCommand}" />
        <MenuItem Header="Clear staged" Command="{Binding ClearStagedCommand}" />
        <Separator />
        <MenuItem Header="Review / execute staged plan..." Click="OnReviewStagedExecution" IsEnabled="{Binding CanStage}" />
        <MenuItem Header="Open execution database..." Click="OnOpenExecution" IsEnabled="{Binding !IsBusy}" />
      </MenuItem>
      <MenuItem Header="_Panels">
        <MenuItem Header="Refresh both" Command="{Binding RefreshAllCommand}" />
        <MenuItem Header="Compare folders" Command="{Binding CompareFoldersCommand}" />
        <MenuItem Header="Activate left" Command="{Binding SetActiveCommand}" CommandParameter="Left" />
        <MenuItem Header="Activate right" Command="{Binding SetActiveCommand}" CommandParameter="Right" />
      </MenuItem>
      <MenuItem Header="_Inventory">
        <MenuItem Header="Backup coverage..." Click="OnBackupCoverage" />
        <MenuItem Header="Inventory jobs..." Click="OnShowInventoryJobs" IsEnabled="{Binding HasDatabasePanels}" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" Padding="6,4" BorderBrush="Gray" BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal" ItemSpacing="6">
        <Button Command="{Binding RefreshActiveCommand}" ToolTip.Tip="Refresh active panel" Width="30" Height="30" Padding="5" IsEnabled="{Binding !IsBusy}">
          <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.89,16.33 14.62,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                Fill="{DynamicResource AppTextBrush}" Stretch="Uniform" />
        </Button>
        <Button Command="{Binding SwapPanelsCommand}" ToolTip.Tip="Swap panels" Width="30" Height="30" Padding="5" IsEnabled="{Binding !IsBusy}">
          <Path Data="M7,7H17V10L21,6L17,2V5H5V11H7V7M17,17H7V14L3,18L7,22V19H19V13H17V17Z"
                Fill="{DynamicResource AppTextBrush}" Stretch="Uniform" />
        </Button>
        <Button Click="OnShowStaged" ToolTip.Tip="Staged operations" Width="30" Height="30" Padding="5">
          <Path Data="M9,5H7A2,2 0 0,0 5,7V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V7A2,2 0 0,0 17,5H15V4A2,2 0 0,0 13,2H11A2,2 0 0,0 9,4V5M9,7H15V5H9V7M7,9H17V11H7V9M7,13H15V15H7V13M7,17H13V19H7V17Z"
                Fill="{DynamicResource AppTextBrush}" Stretch="Uniform" />
        </Button>
        <Button Content="Compare folders" Command="{Binding CompareFoldersCommand}" />
        <Button Content="Clear comparison" Command="{Binding ClearComparisonCommand}" IsEnabled="{Binding IsComparisonEnabled}" />
        <CheckBox Content="Differences only" IsChecked="{Binding DifferencesOnly}" IsEnabled="{Binding IsComparisonEnabled}" />
        <CheckBox Content="Linked browsing" IsChecked="{Binding LinkedBrowsing}" IsEnabled="{Binding IsComparisonEnabled}" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="6" IsVisible="{Binding HasDatabasePanels}">
      <WrapPanel Orientation="Horizontal" ItemSpacing="6">
        <TextBlock Text="Plan ID:" VerticalAlignment="Center" />
        <TextBox Text="{Binding PlanId}" Width="165" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Plan left → right..." Tag="LeftToRight" Click="OnDatabasePlan" IsEnabled="{Binding CanCreateDatabasePlan}" />
        <Button Content="Plan right → left..." Tag="RightToLeft" Click="OnDatabasePlan" IsEnabled="{Binding CanCreateDatabasePlan}" />
        <TextBlock Text="Plans use the whole selected roots." VerticalAlignment="Center" />
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="Gray" BorderThickness="0,0,0,1" IsVisible="{Binding !HasDatabasePanels}">
      <WrapPanel Orientation="Horizontal" ItemSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Root:" VerticalAlignment="Center" />
          <TextBox Text="{Binding RootId}" Width="80" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Base:" VerticalAlignment="Center" />
          <TextBox Text="{Binding BasePath}" IsEnabled="{Binding CanChangeBase}" Width="280" />
          <Button Content="Apply" Command="{Binding ApplyBaseCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Plan:" VerticalAlignment="Center" />
          <TextBox Text="{Binding PlanId}" Width="150" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Output DB:" VerticalAlignment="Center" />
          <TextBox Text="{Binding DbPath}" Width="160" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="JSON:" VerticalAlignment="Center" />
          <TextBox Text="{Binding JsonPath}" Width="160" />
        </StackPanel>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="8,6" IsVisible="{Binding IsComparisonEnabled}">
      <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" />
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="6" BorderBrush="Gray" BorderThickness="0,1,0,0">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding PlanSummary}" FontWeight="Bold" IsVisible="{Binding !HasDatabasePanels}" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6" IsVisible="{Binding !HasDatabasePanels}">
          <Button Content="F5 Copy (stage)" Command="{Binding StageCopyCommand}" />
          <Button Content="F6 Move (stage)" Command="{Binding StageMoveCommand}" />
          <Button Content="F7 Mkdir (stage)" Click="OnMkdir" IsEnabled="{Binding CanStage}" />
          <Button Content="F8 Delete (stage trash)" Command="{Binding StageTrashCommand}" />
          <Button Content="Save JSON" Command="{Binding SaveJsonCommand}" />
          <Button Content="Write to DB" Command="{Binding WriteToDbCommand}" />
          <Button Content="Review / execute..." Click="OnReviewStagedExecution" IsEnabled="{Binding CanStage}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid x:Name="SplitGrid" ColumnDefinitions="*,Auto,*">
      <Border Grid.Column="0" Classes="panel" Classes.active="{Binding IsLeftActive}"
              Margin="0,4,0,4" CornerRadius="4">
        <DockPanel>
          <ContentControl DockPanel.Dock="Top" Content="{Binding Left}" ContentTemplate="{StaticResource PanelHeader}" />
          <views:InventoryDetailsControl DockPanel.Dock="Bottom" DataContext="{Binding Left}" />
          <DataGrid x:Name="LeftList" Tag="Left" ItemsSource="{Binding Left.Entries}" SelectedItem="{Binding Left.SelectedEntry}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" DoubleTapped="OnLeftDoubleTapped">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="30" CanUserResize="False" CanUserSort="False" CellTemplate="{StaticResource FileIconTemplate}" />
              <DataGridTemplateColumn Header="Name" Tag="Name" CanUserSort="True" Width="*" MinWidth="100" CellTemplate="{StaticResource NameCell}" />
              <DataGridTemplateColumn Header="Ext" Tag="Ext" CanUserSort="True" Width="70" CellTemplate="{StaticResource ExtCell}" />
              <DataGridTemplateColumn Header="Size" Tag="Size" CanUserSort="True" Width="100" CellTemplate="{StaticResource SizeCell}" />
              <DataGridTemplateColumn Header="Modified" Tag="Modified" CanUserSort="True" Width="150" CellTemplate="{StaticResource ModifiedCell}" />
              <DataGridTemplateColumn Header="Comparison" CanUserSort="False" IsVisible="{Binding IsComparisonEnabled}" Width="125" CellTemplate="{StaticResource ComparisonCell}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" ResizeBehavior="PreviousAndNext" Background="Gray"
                    DoubleTapped="OnSplitterDoubleTapped" ToolTip.Tip="Double-click to restore 50/50" />
      <Border Grid.Column="2" Classes="panel" Classes.active="{Binding !IsLeftActive}"
              Margin="0,4,0,4" CornerRadius="4">
        <DockPanel>
          <ContentControl DockPanel.Dock="Top" Content="{Binding Right}" ContentTemplate="{StaticResource PanelHeader}" />
          <views:InventoryDetailsControl DockPanel.Dock="Bottom" DataContext="{Binding Right}" />
          <DataGrid x:Name="RightList" Tag="Right" ItemsSource="{Binding Right.Entries}" SelectedItem="{Binding Right.SelectedEntry}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" DoubleTapped="OnRightDoubleTapped">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="30" CanUserResize="False" CanUserSort="False" CellTemplate="{StaticResource FileIconTemplate}" />
              <DataGridTemplateColumn Header="Name" Tag="Name" CanUserSort="True" Width="*" MinWidth="100" CellTemplate="{StaticResource NameCell}" />
              <DataGridTemplateColumn Header="Ext" Tag="Ext" CanUserSort="True" Width="70" CellTemplate="{StaticResource ExtCell}" />
              <DataGridTemplateColumn Header="Size" Tag="Size" CanUserSort="True" Width="100" CellTemplate="{StaticResource SizeCell}" />
              <DataGridTemplateColumn Header="Modified" Tag="Modified" CanUserSort="True" Width="150" CellTemplate="{StaticResource ModifiedCell}" />
              <DataGridTemplateColumn Header="Comparison" CanUserSort="False" IsVisible="{Binding IsComparisonEnabled}" Width="125" CellTemplate="{StaticResource ComparisonCell}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
