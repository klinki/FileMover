<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BackupNormalizer.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="BackupNormalizer.Ui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BackupNormalizer Planner — Total Commander style (plan-only)">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Save plan JSON" Command="{Binding SaveJsonCommand}" />
        <MenuItem Header="Write plan to DB" Command="{Binding WriteToDbCommand}" />
        <MenuItem Header="Clear staged" Command="{Binding ClearStagedCommand}" />
      </MenuItem>
      <MenuItem Header="_Panels">
        <MenuItem Header="Refresh both" Command="{Binding RefreshAllCommand}" />
        <MenuItem Header="Activate left" Command="{Binding SetActiveCommand}" CommandParameter="Left" />
        <MenuItem Header="Activate right" Command="{Binding SetActiveCommand}" CommandParameter="Right" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: logical root + base + plan identity -->
    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="Gray" BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal" ItemSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Root:" VerticalAlignment="Center" />
          <TextBox Text="{Binding RootId}" Width="80" ToolTip.Tip="Logical root id stored in plan (remap later via --map-root)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Base (drive-local):" VerticalAlignment="Center" />
          <TextBox Text="{Binding BasePath}" Width="320" />
          <Button Content="Apply" Command="{Binding ApplyBaseCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Plan:" VerticalAlignment="Center" />
          <TextBox Text="{Binding PlanId}" Width="150" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="DB:" VerticalAlignment="Center" />
          <TextBox Text="{Binding DbPath}" Width="160" />
          <TextBlock Text="JSON:" VerticalAlignment="Center" />
          <TextBox Text="{Binding JsonPath}" Width="160" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Status -->
    <Border DockPanel.Dock="Bottom" Padding="6" BorderBrush="Gray" BorderThickness="0,1,0,0">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding PlanSummary}" FontWeight="Bold" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6">
          <Button Content="F5 Copy (stage)" Command="{Binding StageCopyCommand}" />
          <Button Content="F6 Move (stage)" Command="{Binding StageMoveCommand}" />
          <Button Content="F7 Mkdir (stage)" Command="{Binding StageMkdirCommand}" />
          <TextBox Text="{Binding NewFolderName}" Width="140" PlaceholderText="new folder name" />
          <Button Content="F8 Delete (stage trash)" Command="{Binding StageTrashCommand}" />
          <Button Content="Save JSON" Command="{Binding SaveJsonCommand}" />
          <Button Content="Write to DB" Command="{Binding WriteToDbCommand}" />
        </WrapPanel>
        <TextBlock Text="Plan-only: F5/F6/F7/F8 stage operations with size+hash preconditions. Nothing is executed here. Run executor later; remap drives with --map-root." FontStyle="Italic" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Main area: two panels + staged list -->
    <Grid RowDefinitions="*,220" ColumnDefinitions="*,*">
      <!-- Left panel -->
      <Border Grid.Row="0" Grid.Column="0" Margin="6" BorderBrush="DodgerBlue" BorderThickness="2" CornerRadius="4"
              IsVisible="{Binding IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="◀ LEFT (active source/dest — click to activate)" FontWeight="Bold" />
            <TextBox Text="{Binding Left.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Up" Command="{Binding GoUpLeftCommand}" />
              <Button Content="Refresh" Command="{Binding RefreshAllCommand}" />
              <TextBlock Text="{Binding Left.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="LeftList" ItemsSource="{Binding Left.Entries}" SelectedItem="{Binding Left.SelectedEntry}"
                   DoubleTapped="OnLeftDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileEntryItem">
                <Grid ColumnDefinitions="*,90,130">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="0" Grid.Column="0" Margin="6" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
              IsVisible="{Binding !IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="LEFT (click to activate)" />
            <TextBox Text="{Binding Left.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Up" Command="{Binding GoUpLeftCommand}" />
              <TextBlock Text="{Binding Left.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ListBox ItemsSource="{Binding Left.Entries}" SelectedItem="{Binding Left.SelectedEntry}"
                   PointerPressed="OnLeftPressed" DoubleTapped="OnLeftDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileEntryItem">
                <Grid ColumnDefinitions="*,90,130">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Right panel -->
      <Border Grid.Row="0" Grid.Column="1" Margin="6" BorderBrush="DodgerBlue" BorderThickness="2" CornerRadius="4"
              IsVisible="{Binding !IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="▶ RIGHT (active source/dest — click to activate)" FontWeight="Bold" />
            <TextBox Text="{Binding Right.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Up" Command="{Binding GoUpRightCommand}" />
              <Button Content="Refresh" Command="{Binding RefreshAllCommand}" />
              <TextBlock Text="{Binding Right.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ListBox x:Name="RightList" ItemsSource="{Binding Right.Entries}" SelectedItem="{Binding Right.SelectedEntry}"
                   DoubleTapped="OnRightDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileEntryItem">
                <Grid ColumnDefinitions="*,90,130">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Row="0" Grid.Column="1" Margin="6" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
              IsVisible="{Binding IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="RIGHT (click to activate)" />
            <TextBox Text="{Binding Right.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Content="Up" Command="{Binding GoUpRightCommand}" />
              <TextBlock Text="{Binding Right.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <ListBox ItemsSource="{Binding Right.Entries}" SelectedItem="{Binding Right.SelectedEntry}"
                   PointerPressed="OnRightPressed" DoubleTapped="OnRightDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileEntryItem">
                <Grid ColumnDefinitions="*,90,130">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Staged operations -->
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="6" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="4">
            <TextBlock Text="Staged operations (plan-only)" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="Remove selected" Command="{Binding RemoveStagedCommand}" CommandParameter="{Binding ElementName=StagedList, Path=SelectedItem}" />
            <Button Content="Clear" Command="{Binding ClearStagedCommand}" />
          </StackPanel>
          <ListBox x:Name="StagedList" ItemsSource="{Binding Staged}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StagedOpItem">
                <Grid ColumnDefinitions="70,*,*,90,110">
                  <TextBlock Grid.Column="0" Text="{Binding Type}" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="{Binding Dest}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="{Binding HashShort}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
