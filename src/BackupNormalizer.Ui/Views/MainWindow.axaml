<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BackupNormalizer.Ui.ViewModels"
        xmlns:conv="using:BackupNormalizer.Ui.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="BackupNormalizer.Ui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BackupNormalizer Planner — Total Commander style (plan-only)">
  <Window.Resources>
    <conv:MarkedToBrushConverter x:Key="MarkedToBrush" />
    <DataTemplate x:Key="FileIconTemplate" x:DataType="vm:FileEntryItem">
      <Panel Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Path Data="M13,20H11V8L5.5,13.5L4.08,12.08L12,4.16L19.92,12.08L18.5,13.5L13,8V20Z"
              Fill="#78909C" Stretch="Uniform" IsVisible="{Binding IsParentEntry}" />
        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
              Fill="#E8A33D" Stretch="Uniform" IsVisible="{Binding IsFolder}" />
        <Path Data="M3,3H21V7H3V3M4,8H20V21H4V8M9.5,11A0.5,0.5 0 0,0 9,11.5V13H15V11.5A0.5,0.5 0 0,0 14.5,11H9.5Z"
              Fill="#8D6E63" Stretch="Uniform" IsVisible="{Binding IsArchive}" />
        <Path Data="M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z"
              Fill="#43A047" Stretch="Uniform" IsVisible="{Binding IsImage}" />
        <Path Data="M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z"
              Fill="#E53935" Stretch="Uniform" IsVisible="{Binding IsVideo}" />
        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M14,4L18,8H14V4M16,11H8V13H16V11M16,15H8V17H16V15Z"
              Fill="#1E88E5" Stretch="Uniform" IsVisible="{Binding IsText}" />
        <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
              Fill="#9AA0A6" Stretch="Uniform" IsVisible="{Binding IsGenericFile}" />
      </Panel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Save plan JSON" Command="{Binding SaveJsonCommand}" />
        <MenuItem Header="Write plan to DB" Command="{Binding WriteToDbCommand}" />
        <MenuItem Header="Clear staged" Command="{Binding ClearStagedCommand}" />
      </MenuItem>
      <MenuItem Header="_Panels">
        <MenuItem Header="Refresh both" Command="{Binding RefreshAllCommand}" />
        <MenuItem Header="Activate left" Command="{Binding SetActiveCommand}" CommandParameter="Left" />
        <MenuItem Header="Activate right" Command="{Binding SetActiveCommand}" CommandParameter="Right" />
      </MenuItem>
    </Menu>

    <!-- TC-style icon toolbar -->
    <Border DockPanel.Dock="Top" Padding="4,2" BorderBrush="Gray" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Command="{Binding RefreshActiveCommand}" ToolTip.Tip="Refresh active panel" Width="30" Height="30" Padding="5">
          <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.89,16.33 14.62,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                Fill="{DynamicResource SystemBaseHighColor}" Stretch="Uniform" />
        </Button>
        <Button Command="{Binding SwapPanelsCommand}" ToolTip.Tip="Swap panels" Width="30" Height="30" Padding="5">
          <Path Data="M7,7H17V10L21,6L17,2V5H5V11H7V7M17,17H7V14L3,18L7,22V19H19V13H17V17Z"
                Fill="{DynamicResource SystemBaseHighColor}" Stretch="Uniform" />
        </Button>
        <Button Click="OnShowStaged" ToolTip.Tip="Staged operations" Width="30" Height="30" Padding="5">
          <Path Data="M9,5H7A2,2 0 0,0 5,7V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V7A2,2 0 0,0 17,5H15V4A2,2 0 0,0 13,2H11A2,2 0 0,0 9,4V5M9,7H15V5H9V7M7,9H17V11H7V9M7,13H15V15H7V13M7,17H13V19H7V17Z"
                Fill="{DynamicResource SystemBaseHighColor}" Stretch="Uniform" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Toolbar: logical root + base + plan identity -->
    <Border DockPanel.Dock="Top" Padding="6" BorderBrush="Gray" BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal" ItemSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Root:" VerticalAlignment="Center" />
          <TextBox Text="{Binding RootId}" Width="80" ToolTip.Tip="Logical root id stored in plan (remap later via --map-root)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Base (drive-local):" VerticalAlignment="Center" />
          <TextBox Text="{Binding BasePath}" Width="320" />
          <Button Content="Apply" Command="{Binding ApplyBaseCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Plan:" VerticalAlignment="Center" />
          <TextBox Text="{Binding PlanId}" Width="150" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="DB:" VerticalAlignment="Center" />
          <TextBox Text="{Binding DbPath}" Width="160" />
          <TextBlock Text="JSON:" VerticalAlignment="Center" />
          <TextBox Text="{Binding JsonPath}" Width="160" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Status -->
    <Border DockPanel.Dock="Bottom" Padding="6" BorderBrush="Gray" BorderThickness="0,1,0,0">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding PlanSummary}" FontWeight="Bold" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="6">
          <Button Content="F5 Copy (stage)" Command="{Binding StageCopyCommand}" />
          <Button Content="F6 Move (stage)" Command="{Binding StageMoveCommand}" />
          <Button Content="F7 Mkdir (stage)" Click="OnMkdir" />
          <Button Content="F8 Delete (stage trash)" Command="{Binding StageTrashCommand}" />
          <Button Content="Save JSON" Command="{Binding SaveJsonCommand}" />
          <Button Content="Write to DB" Command="{Binding WriteToDbCommand}" />
        </WrapPanel>
        <TextBlock Text="Plan-only: F5/F6/F7/F8 stage operations with size+hash preconditions. Nothing is executed here. Run executor later; remap drives with --map-root. Shortcuts: Ctrl/Cmd+A mark all, Space toggle, Shift+arrows extend, Esc clear marks, Tab switch panel." FontStyle="Italic" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Main area: two panels + staged list -->
    <Grid ColumnDefinitions="*,Auto,*">
      <!-- Left panel -->
      <Border Grid.Column="0" Margin="0,6,0,6" BorderBrush="DodgerBlue" BorderThickness="2" CornerRadius="4"
              IsVisible="{Binding IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="◀ LEFT (active source/dest — click to activate)" FontWeight="Bold" />
            <TextBox Text="{Binding Left.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Left.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <DataGrid x:Name="LeftList" Tag="Left"
                    ItemsSource="{Binding Left.Entries}" SelectedItem="{Binding Left.SelectedEntry}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                    DoubleTapped="OnLeftDoubleTapped">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="30" CanUserResize="False" CanUserSort="False" CellTemplate="{StaticResource FileIconTemplate}" />
              <DataGridTemplateColumn Header="Name" Tag="Name" Width="*" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding BaseName}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Ext" Tag="Ext" Width="70" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding Extension}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Size" Tag="Size" Width="100" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding SizeText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Modified" Tag="Modified" Width="140" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding ModifiedText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="0" Margin="0,6,0,6" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
              IsVisible="{Binding !IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="LEFT (click to activate)" />
            <TextBox Text="{Binding Left.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Left.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <DataGrid Tag="Left"
                    ItemsSource="{Binding Left.Entries}" SelectedItem="{Binding Left.SelectedEntry}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                    DoubleTapped="OnLeftDoubleTapped">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="30" CanUserResize="False" CanUserSort="False" CellTemplate="{StaticResource FileIconTemplate}" />
              <DataGridTemplateColumn Header="Name" Tag="Name" Width="*" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding BaseName}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Ext" Tag="Ext" Width="70" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding Extension}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Size" Tag="Size" Width="100" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding SizeText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Modified" Tag="Modified" Width="140" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding ModifiedText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="6" ResizeBehavior="PreviousAndNext" Background="Gray" />

      <!-- Right panel -->
      <Border Grid.Column="2" Margin="0,6,0,6" BorderBrush="DodgerBlue" BorderThickness="2" CornerRadius="4"
              IsVisible="{Binding !IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="▶ RIGHT (active source/dest — click to activate)" FontWeight="Bold" />
            <TextBox Text="{Binding Right.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Right.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <DataGrid x:Name="RightList" Tag="Right"
                    ItemsSource="{Binding Right.Entries}" SelectedItem="{Binding Right.SelectedEntry}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                    DoubleTapped="OnRightDoubleTapped">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="30" CanUserResize="False" CanUserSort="False" CellTemplate="{StaticResource FileIconTemplate}" />
              <DataGridTemplateColumn Header="Name" Tag="Name" Width="*" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding BaseName}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Ext" Tag="Ext" Width="70" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding Extension}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Size" Tag="Size" Width="100" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding SizeText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Modified" Tag="Modified" Width="140" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding ModifiedText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Margin="0,6,0,6" BorderBrush="Gray" BorderThickness="1" CornerRadius="4"
              IsVisible="{Binding IsLeftActive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Spacing="2" Margin="4">
            <TextBlock Text="RIGHT (click to activate)" />
            <TextBox Text="{Binding Right.CurrentPath}" IsReadOnly="True" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding Right.Status}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <DataGrid Tag="Right"
                    ItemsSource="{Binding Right.Entries}" SelectedItem="{Binding Right.SelectedEntry}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                    DoubleTapped="OnRightDoubleTapped">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="30" CanUserResize="False" CanUserSort="False" CellTemplate="{StaticResource FileIconTemplate}" />
              <DataGridTemplateColumn Header="Name" Tag="Name" Width="*" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding BaseName}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Ext" Tag="Ext" Width="70" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding Extension}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Size" Tag="Size" Width="100" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding SizeText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Modified" Tag="Modified" Width="140" CanUserSort="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:FileEntryItem">
                    <TextBlock Text="{Binding ModifiedText}" Foreground="{Binding IsMarked, Converter={StaticResource MarkedToBrush}}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>
</Window>
