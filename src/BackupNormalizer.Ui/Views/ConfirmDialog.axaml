<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="140"
        x:Class="BackupNormalizer.Ui.Views.ConfirmDialog"
        Icon="/Assets/avalonia-logo.ico"
        Title="Confirm"
        Width="420" Height="140"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Spacing="8" Margin="12">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="OK" IsDefault="True" MinWidth="90" Click="OnOk" />
      <Button Content="Cancel" IsCancel="True" MinWidth="90" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
