<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BackupNormalizer.Ui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
        x:Class="BackupNormalizer.Ui.Views.StagedOperationsWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Staged operations (plan-only)">
  <DockPanel KeyDown="OnKeyDown">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6">
      <TextBlock Text="Staged operations (plan-only)" FontWeight="Bold" VerticalAlignment="Center" />
      <Button Content="Remove selected" Command="{Binding RemoveStagedCommand}" CommandParameter="{Binding ElementName=StagedList, Path=SelectedItem}" />
      <Button Content="Clear" Command="{Binding ClearStagedCommand}" />
      <TextBlock Text="{Binding PlanSummary}" VerticalAlignment="Center" />
    </StackPanel>
    <DataGrid x:Name="StagedList" ItemsSource="{Binding Staged}" Margin="6,0,6,6"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              CanUserResizeColumns="True" CanUserSortColumns="False" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Op" Binding="{Binding Type}" Width="70" />
        <DataGridTemplateColumn Header="Source" Width="*" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StagedOpItem">
              <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Destination" Width="*" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StagedOpItem">
              <TextBlock Text="{Binding Dest}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
        <DataGridTemplateColumn Header="Hash" Width="200" CanUserSort="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:StagedOpItem">
              <TextBlock Text="{Binding HashFull}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
